[Unit]
Description=SalesOS AMI Consumer (Asterisk event ingestion)
After=network.target redis.service mariadb.service
Requires=redis.service mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/crm/modules/salesos/daemons
ExecStart=/usr/bin/php /var/www/html/crm/modules/salesos/daemons/ami_consumer.php
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=salesos-ami

# Allow the daemon enough time to flush state on stop
TimeoutStopSec=15

# Prevent the daemon from writing outside its working area
ReadWritePaths=/var/www/html/crm/modules/salesos/daemons

[Install]
WantedBy=multi-user.target
