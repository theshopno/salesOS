[Unit]
Description=SalesOS Event Archiver (Redis Streams → MySQL)
After=network.target redis.service redis-server.service mysql.service mariadb.service
Wants=redis.service redis-server.service mysql.service mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/crm/modules/salesos/daemons
ExecStart=/usr/bin/php /var/www/html/crm/modules/salesos/daemons/event_archiver.php
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=salesos-archiver

TimeoutStopSec=15

ReadWritePaths=/var/www/html/crm/modules/salesos/daemons

[Install]
WantedBy=multi-user.target
