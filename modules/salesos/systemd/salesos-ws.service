[Unit]
Description=SalesOS WebSocket Server (real-time browser relay)
After=network.target redis.service
Requires=redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/crm/modules/salesos/daemons
ExecStart=/usr/bin/php /var/www/html/crm/modules/salesos/daemons/ws_server.php
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=salesos-ws

TimeoutStopSec=15

# Ratchet binds to ws_port (default 8080) — ensure that port is firewalled
# and only reachable via the Nginx proxy defined in salesos_ws.conf
ReadWritePaths=/var/www/html/crm/modules/salesos/daemons

[Install]
WantedBy=multi-user.target
